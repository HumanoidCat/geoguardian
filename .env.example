# Copiar a .env y completar. .env nunca se sube al repositorio.

# Base de datos
#
# Ojo con estos dos nombres, que no son lo mismo:
#
#   POSTGRES_HOST        lo consume docker-compose para nombrar el servicio
#                        dentro de su red. Los guiones de Python NO lo leen.
#   POSTGRES_HOST_LOCAL  es la que lee conexion.py, porque los guiones corren
#                        desde la maquina anfitriona, fuera de esa red.
#
# Si vas a apuntar los guiones a otra base -otra maquina, un proveedor de nube-,
# la que hay que cambiar es POSTGRES_HOST_LOCAL. Cambiar POSTGRES_HOST no hace
# nada y no avisa. Se agrega aca por H11.6, donde costo un rato averiguarlo.
POSTGRES_HOST=db
POSTGRES_HOST_LOCAL=localhost
POSTGRES_PORT=5432
POSTGRES_DB=geoguardian
POSTGRES_USER=
POSTGRES_PASSWORD=

# Roles de aplicacion (minimo privilegio)
#
# Los nombres de usuario estan acordados por el equipo para que la evidencia de
# H1.8 coincida entre las cuatro maquinas. Las contrasenas las pone cada quien en
# su .env y NUNCA se escriben aqui ni en ninguna migracion: un CREATE ROLE con la
# contrasena en el SQL la deja en el historial de git para siempre.
DB_USER_ETL=etl_geoguardian
DB_PASS_ETL=
DB_USER_API=api_geoguardian
DB_PASS_API=

# Fuentes de datos
#
# FIRMS_MAP_KEY  Clave gratuita de NASA FIRMS, para los focos de calor (H1.2).
# COPERNICUS_*   Cuenta gratuita del Data Space Ecosystem, para Sentinel-2 (H1.6).
#                El registro tarda y no lo controlamos: pedirlo con antelacion.
#
# CHIRPS no aparece aqui a proposito: es de dominio publico y no pide credenciales.
# Es la fuente de precipitacion desde D-15, porque NASA POWER no distingue entre
# los distritos del canton. POWER tampoco pide clave y sigue sirviendo temperatura,
# humedad, radiacion y viento.
FIRMS_MAP_KEY=
COPERNICUS_USER=
COPERNICUS_PASSWORD=

# Area de estudio
CANTON=Tilaran
SRID=4326

# API
API_HOST=0.0.0.0
API_PORT=8000
